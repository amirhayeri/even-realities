'--help[Print help]' \
&& ret=0
;;
(ls)
_arguments "${_arguments_options[@]}" : \
'--channels[Include beta/public pointers for each app]' \
'--verbose[Include app details and full rejection messages]' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
'::package_id:' \
&& ret=0
;;
(promote)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'--to=[Target channel (beta only)]:TO:(beta)' \
