#compdef evenhub eh

autoload -U is-at-least

_evenhub() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'--completion-fish[Output fish completion script]' \
'--completion-bash[Output bash completion script]' \
'--completion-zsh[Output zsh completion script]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_evenhub_commands" \
"*::: :->evenhub" \
&& ret=0
    case $state in
    (evenhub)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:evenhub-command-$line[1]:"
        case $line[1] in
            (login)
_arguments "${_arguments_options[@]}" : \
'-e+[Your email]:EMAIL:_email_addresses' \
'--email=[Your email]:EMAIL:_email_addresses' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(init)
_arguments "${_arguments_options[@]}" : \
'-d+[The directory to create the project in]:DIRECTORY:_files -/' \
'--directory=[The directory to create the project in]:DIRECTORY:_files -/' \
'-o+[The output file path, has precedence over --directory]:OUTPUT:_files' \
'--output=[The output file path, has precedence over --directory]:OUTPUT:_files' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(pack)
_arguments "${_arguments_options[@]}" : \
'-o+[The output file name]:OUTPUT:_files' \
'--output=[The output file name]:OUTPUT:_files' \
'--sdk-ver=[SDK version built against; derive its npm minAppVersion floor (default\: latest SDK)]:SDK_VER:' \
'--no-ignore[Include hidden files (starting with '\''.'\'')]' \
'-c[Check if the package id is available]' \
'--check[Check if the package id is available]' \
'--enforce-manual-version[Stamp app.json'\''s min_app_version even below the SDK floor]' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
':manifest:_files' \
':project:_files -/' \
&& ret=0
;;
(qr)
_arguments "${_arguments_options[@]}" : \
'-u+[The full URL; overrides other URL options]:URL:_urls' \
'--url=[The full URL; overrides other URL options]:URL:_urls' \
'-i+[IP address or hostname]:IP:_hosts' \
'--ip=[IP address or hostname]:IP:_hosts' \
'-p+[Port; omit its value to use the default port]::PORT:' \
'--port=[Port; omit its value to use the default port]::PORT:' \
'--path=[URL path]:PATH:' \
'-s+[External image scale (default\: 4)]:SCALE:' \
'--scale=[External image scale (default\: 4)]:SCALE:' \
'--https[Use HTTPS]' \
'--http[Use HTTP]' \
'-e[Open the QR image in an external viewer]' \
'--external[Open the QR image in an external viewer]' \
'--clear[Clear cached scheme, IP, port and path]' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(self-check)
_arguments "${_arguments_options[@]}" : \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'--name=[App display name (1..20 characters)]:NAME:' \
'--tagline=[Short description (1..50 characters)]:TAGLINE:' \
'--description=[Store description (1..2000 characters)]:DESCRIPTION:' \
'--description-file=[Read store description from a file]:DESCRIPTION_FILE:_files' \
'--icon=[24x24 PNG icon with raster-consumed 2x2 pixels]:ICON:_files' \
'--new-draft[Ignore cached draft and upload again]' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
':file:_files' \
&& ret=0
;;
(upload)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'-m+[Version changelog (up to 500 characters)]:CHANGELOG:' \
'--changelog=[Version changelog (up to 500 characters)]:CHANGELOG:' \
'--new-draft[Ignore cached draft and upload again]' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
':file:_files' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'--name=[App display name (1..20 characters)]:NAME:' \
'--tagline=[Short description (1..50 characters)]:TAGLINE:' \
