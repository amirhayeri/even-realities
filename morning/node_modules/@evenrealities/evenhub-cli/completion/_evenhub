&& ret=0
;;
(rm)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
