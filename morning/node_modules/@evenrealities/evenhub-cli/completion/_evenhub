&& ret=0
;;
(logout)
_arguments "${_arguments_options[@]}" : \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_evenhub__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:evenhub-help-command-$line[1]:"
        case $line[1] in
