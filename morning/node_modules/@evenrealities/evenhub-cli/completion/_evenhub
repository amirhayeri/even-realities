;;
(download)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'-o+[Output file (default\: <package_id>-<version>.ehpk)]:OUTPUT:_files' \
'--output=[Output file (default\: <package_id>-<version>.ehpk)]:OUTPUT:_files' \
