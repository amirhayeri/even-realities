(( $+functions[_evenhub_commands] )) ||
_evenhub_commands() {
    local commands; commands=(
'login:Log in interactively with your Even Realities account' \
'init:Initialize a project with a basic app.json file' \
'pack:Pack app.json and a built project folder into a .ehpk file' \
'qr:Generate a development-server QR code' \
'self-check:Show the signed-in account, its role and namespace' \
'create:Create an app and its initial Draft build' \
'upload:Upload a new version to an existing app' \
'update:Update unpublished app name, tagline, description or icon' \
'ls:List account apps, or every version of one app' \
'promote:Assign a version to beta; public publishing stays in the portal' \
'delist:Clear one beta/public channel pointer; retain builds' \
'testers:List beta testers and their invitation status' \
'rm:Delete a build, or an entire app with --app' \
'download:Download a build using a fresh signed storage URL' \
'logout:Invalidate the refresh token and remove local credentials' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'evenhub commands' commands "$@"
}
