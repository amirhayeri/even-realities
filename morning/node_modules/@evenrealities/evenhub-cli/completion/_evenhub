'--from=[Channel to clear (beta or public)]:FROM:(beta public)' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(testers)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'--search=[Search tester emails]:SEARCH:_email_addresses' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_evenhub__testers_commands" \
"*::: :->testers" \
&& ret=0

    case $state in
    (testers)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:evenhub-testers-command-$line[1]:"
        case $line[1] in
            (add)
_arguments "${_arguments_options[@]}" : \
'--package-id=[App identity; defaults to app.json in the current directory]:PACKAGE_ID:' \
'--from=[Read email lines or a single-column CSV]:FROM:_files' \
'--reinvite[Reinvite Invited emails, voiding earlier links; Active members stay]' \
'--json[Output one JSON object; prompts and diagnostics go to stderr]' \
'-h[Print help]' \
'--help[Print help]' \
