{
  "package_id": "com.example.biohud",
  "edition": "202601",
  "name": "Bio HUD",
  "version": "0.1.8",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Fetches your live workout, Spotify, glucose and weather summary from your own HUD endpoint.",
      "whitelist": [
        "https://WORKER_URL"
      ]
    },
    {
      "name": "location",
      "desc": "Local weather and pace."
    }
  ],
  "supported_languages": [
    "en"
  ]
}
