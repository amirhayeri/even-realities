{
  "name": "even-hud",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --host",
    "sim": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "qr": "evenhub qr --port 5173",
    "pack": "evenhub pack app.json dist -o even-hud.ehpk",
    "release": "node release.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "~5.6.0",
    "vite": "^5.4.0"
  }
}
